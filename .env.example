# Copy to .env (never commit .env). All EXPO_PUBLIC_* values are embedded in the
# app bundle and are therefore PUBLIC. Never put secrets (service-role key,
# AI provider key) in an EXPO_PUBLIC_* variable.

# Supabase project URL and anon (public) key. Leave empty to run fully offline
# without accounts (emergency + education + local tracker keep working).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" once the `assistant` Supabase Edge Function is deployed with
# its server-side secret. Otherwise the assistant runs in offline FAQ mode.
EXPO_PUBLIC_ASSISTANT_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (set with `supabase secrets set`, never in the app):
#   ANTHROPIC_API_KEY=...
#   ASSISTANT_MODEL=claude-opus-5-5
# ---------------------------------------------------------------------------
